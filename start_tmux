#!/bin/zsh
set -euo pipefail

# --- Config ---
readonly PROJECTS=(auctionet porter logan neopris ex-remit skipper)
readonly MARKER_DIR="/tmp/tmux_setup_$$"
readonly TIMEOUT=120  # seconds

# --- Helpers ---
mkdir -p "$MARKER_DIR"
trap 'rm -rf "$MARKER_DIR"' EXIT

marker_for()      { echo "$MARKER_DIR/${1}.ok" }
marker_fail_for() { echo "$MARKER_DIR/${1}.fail" }

# Wait for a marker file (ok or fail) to appear, with a timeout.
# Returns 0 on success marker, 1 on failure marker or timeout.
wait_for_marker() {
  local name=$1 timeout=${2:-$TIMEOUT}
  local start=$SECONDS
  while true; do
    [[ -f $(marker_for "$name") ]]      && return 0
    [[ -f $(marker_fail_for "$name") ]] && return 1
    if (( SECONDS - start >= timeout )); then
      echo "🛑 Timeout waiting for: $name"
      return 1
    fi
    sleep 1
  done
}

# Wait for multiple markers in parallel (polls until all have ok/fail or timeout).
# Reports failures at the end but does not itself return non-zero.
wait_for_all_markers() {
  local names=("$@") timeout=$TIMEOUT start=$SECONDS failed=()
  while (( ${#names} > 0 )); do
    if (( SECONDS - start >= timeout )); then
      echo "🛑 Timeout! Still waiting on: ${names[*]}"
      failed+=("${names[@]}")
      break
    fi
    local remaining=()
    for name in $names; do
      if   [[ -f $(marker_for "$name") ]];      then :  # done, success
      elif [[ -f $(marker_fail_for "$name") ]]; then failed+=("$name")
      else remaining+=("$name")
      fi
    done
    names=("${remaining[@]}")
    (( ${#names} > 0 )) && { echo "   ... ${#names} project(s) still pulling: ${names[*]}"; sleep 2 }
  done
  if (( ${#failed} > 0 )); then
    echo "⚠️  'gl' failed or timed out for: ${failed[*]}"
    echo "   Check those tmux panes for unstaged changes or other errors."
  fi
}

new_session() {
  local name=$1 dir=$2
  tmux new-session -d -s "$name"
  tmux send-keys -t "$name:1" "cd $dir" C-m
  tmux new-window -d -t "$name:9" -n 'webserver'
  tmux send-keys -t "$name:9" "cd $dir" C-m
}

# --- Global Sessions ---
tmux new-session -d -s 'dotfiles'
tmux send-keys -t 'dotfiles:1' 'cd ~/.dotfiles' C-m

tmux new-session -d -s 'devbox'
tmux send-keys -t 'devbox:1' 'cd /devbox && dev' C-m

# --- Create all project sessions and kick off parallel 'gl' pulls ---
for project in $PROJECTS; do
  echo "Starting session: $project"
  new_session "$project" "/projects/$project"
  local ok=$(marker_for $project) fail=$(marker_fail_for $project)
  tmux send-keys -t "$project:1" "gl && touch $ok || touch $fail" C-m
done

# --- Wait for all pulls to complete ---
echo "\nWaiting for all 'gl' commands to finish (max ${TIMEOUT}s)..."
wait_for_all_markers $PROJECTS && echo "✅ All 'gl' commands finished."

# --- auctionet: dev, then reset, then web ---
echo "Running 'dev' in auctionet..."
local ok=$(marker_for auctionet_dev) fail=$(marker_fail_for auctionet_dev)
tmux send-keys -t 'auctionet:1' "dev && touch $ok || touch $fail" C-m
if wait_for_marker auctionet_dev; then
  echo "✅ 'dev' finished for auctionet. Running reset and launching web server."
  tmux send-keys -t 'auctionet:1' 'rake app:reset' C-m
  tmux send-keys -t 'auctionet:9' 'dev web' C-m
else
  echo "⚠️  Skipping auctionet post-setup due to timeout or failure."
fi
tmux select-window -t 'auctionet:1'

# --- Other projects ---
for project in porter logan neopris ex-remit; do
  tmux send-keys -t "$project:1" 'dev update' C-m
  tmux send-keys -t "$project:9" 'dev web' C-m
  tmux select-window -t "$project:1"
done

# skipper uses make instead of dev
tmux send-keys -t 'skipper:9' 'make dev' C-m
tmux select-window -t 'skipper:1'

# --- Attach ---
tmux attach-session -t "$PROJECTS[1]"
